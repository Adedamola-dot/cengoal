.env
.env.local
.env.*.local
!.env.example

# ─── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# ─── OS noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ─── Testing ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ─── Deployment ────────────────────────────────────────────────
.vercel

# ─── Uploads (R2 files never touch our server disk) ────────────
uploads/
tmp/

# ─── PWA generated artifacts ───────────────────────────────────
apps/web/dev-dist/
apps/web/dist/sw.js
apps/web/dist/workbox-*.js